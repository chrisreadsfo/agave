# Browserbase — only needed for `npm run cloud`.
# Key from https://www.browserbase.com/settings; the project is inferred from it.
BROWSERBASE_API_KEY=

# Fieldwire — a free account is fine (3 projects / 100 sheets / 5 users, no expiry).
FIELDWIRE_EMAIL=
FIELDWIRE_PASSWORD=

# Optional: project to open, by name as it appears on the card.
# Blank picks the first one. --project overrides it.
FIELDWIRE_PROJECT=
