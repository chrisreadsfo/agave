# ── Browserbase ──────────────────────────────────────────────────────────────
# Paste your key from https://www.browserbase.com/settings (project is inferred from it)
BROWSERBASE_API_KEY=
# Optional: a Browserbase Context id persists the Fieldwire login cookies in the
# cloud so remote runs skip the login form. Create one with:
#   npx browse cloud contexts create
BROWSERBASE_CONTEXT_ID=

# ── Fieldwire ────────────────────────────────────────────────────────────────
# Free plan account is fine (3 projects / 100 sheets / 5 users, no expiry)
FIELDWIRE_EMAIL=
FIELDWIRE_PASSWORD=
# Limit a sync to one project; blank = every project on the account
FIELDWIRE_PROJECT_ID=

# ── Runner ───────────────────────────────────────────────────────────────────
# Set HEADLESS=false to watch a local Chromium drive the site
HEADLESS=true
SLOW_MO=0
OUT_DIR=./out
PORT=8787
