{
  "name": "agave-fieldwire-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Headless-browser connector that gives Fieldwire an Agave-style unified API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "login": "tsx src/cli.ts login",
    "discover": "tsx src/cli.ts discover",
    "sync": "tsx src/cli.ts sync",
    "serve": "tsx src/cli.ts serve",
    "fixtures": "tsx src/cli.ts sync --fixtures",
    "typecheck": "tsc --noEmit",
    "message": "tsx src/cli.ts message"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^4.0.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.49.1",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
